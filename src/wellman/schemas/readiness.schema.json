{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/docs-readiness-v1.json",
  "title": "wellmanifest/docs adopter readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "standard",
    "standard_version",
    "standard_revision",
    "policy_sha256",
    "checker_sha256",
    "covered_roots",
    "base_sha",
    "head_sha",
    "phase",
    "observed_at",
    "evidence",
    "compatibility_review",
    "generator"
  ],
  "properties": {
    "schema": {"const": "wellmanifest.docs/readiness/v1"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "standard": {"type": "string", "minLength": 1},
    "standard_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "covered_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"}
    },
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "phase": {"enum": ["unavailable", "unadopted", "configured", "deployed", "verified"]},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unavailable", "unadopted", "configured", "deployed", "verified"],
      "properties": {
        "unavailable": {"$ref": "#/$defs/evidence"},
        "unadopted": {"$ref": "#/$defs/evidence"},
        "configured": {"$ref": "#/$defs/evidence"},
        "deployed": {"$ref": "#/$defs/evidence"},
        "verified": {"$ref": "#/$defs/evidence"}
      }
    },
    "compatibility_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "reviewer", "evidence"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not-required", "pending", "accepted", "rejected"]},
        "reviewer": {"type": ["string", "null"], "maxLength": 200},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?:repo|github|receipt|artifact|knowledge)://[^\\s]+$"
      }
    }
  }
}
