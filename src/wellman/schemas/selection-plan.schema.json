{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/wellman/selection-plan.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "wellman.selection-plan/v1"
    },
    "mode": {
      "const": "recommendation"
    },
    "grants_authority": {
      "const": false
    },
    "executable": {
      "const": false
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rule_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "adoption_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "quality_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "plan_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "rendered_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|\\+00:00)$"
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "mode",
    "grants_authority",
    "executable",
    "observation_id",
    "observation_digest",
    "catalog_digest",
    "rule_digest",
    "source_digests",
    "adoption_digests",
    "decisions",
    "quality_issues"
  ],
  "additionalProperties": false,
  "$defs": {
    "adoption": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "verified",
            "drifted",
            "declared",
            "missing",
            "unknown"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "conformance": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "state",
        "revision",
        "manifest_digest",
        "lock_digest",
        "conformance",
        "evidence_refs",
        "exceptions"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "standard_id": {
          "type": "string",
          "pattern": "^wellmanifest/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "scope": {
          "type": "string",
          "enum": [
            "workspace",
            "repository",
            "component",
            "runtime"
          ]
        },
        "applicability": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable",
            "insufficient_data"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "keep",
            "add",
            "update",
            "repair",
            "propose_replace",
            "defer"
          ]
        },
        "current": {
          "$ref": "#/$defs/adoption"
        },
        "target_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^wellmanifest/[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "managed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          }
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_authorities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "repository_id",
        "component_id",
        "standard_id",
        "scope",
        "applicability",
        "action",
        "current",
        "target_revision",
        "reasons",
        "evidence_refs",
        "depends_on",
        "conflicts",
        "managed_files",
        "risk",
        "validators",
        "required_authorities",
        "limitations"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "affected_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "affected_refs",
        "next_action"
      ],
      "additionalProperties": false
    }
  }
}
