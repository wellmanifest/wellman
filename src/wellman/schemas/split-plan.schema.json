{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/split-plan/v1",
  "title": "Wellmanifest oversized-ticket split plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "planRef",
    "repositoryRef",
    "parentTicket",
    "sliceId",
    "idempotencyKey",
    "parent",
    "completedSlice",
    "successors",
    "integrationOwnerTicket"
  ],
  "properties": {
    "schema": { "const": "wellmanifest.split-plan/v1" },
    "kind": { "const": "split-plan" },
    "planRef": { "$ref": "#/$defs/artifactRef" },
    "repositoryRef": { "$ref": "#/$defs/repositoryRef" },
    "parentTicket": { "$ref": "#/$defs/ticket" },
    "sliceId": { "$ref": "#/$defs/sliceId" },
    "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
    "parent": { "$ref": "#/$defs/parentCheckpoint" },
    "completedSlice": { "$ref": "#/$defs/completedSlice" },
    "successors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/successor" }
    },
    "integrationOwnerTicket": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ticket" }
      ]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ticket": {
      "type": "string",
      "pattern": "^ticket-[0-9]{3,}$"
    },
    "artifactRef": {
      "type": "string",
      "pattern": "^artifact:[a-z][a-z0-9._:-]{0,159}$"
    },
    "receiptRef": {
      "type": "string",
      "pattern": "^receipt:[a-z][a-z0-9._:-]{0,159}$"
    },
    "repositoryRef": {
      "type": "string",
      "pattern": "^repository:[a-z][a-z0-9._-]{0,95}$"
    },
    "sliceId": {
      "type": "string",
      "pattern": "^slice:[a-z][a-z0-9._-]{0,95}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^node:[a-z][a-z0-9._-]{0,95}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^idempotency:[a-z][a-z0-9._-]{0,127}$"
    },
    "scopePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:[/\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+(?:/\\*\\*)?$"
    },
    "materialPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:[/\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scopePath" }
    },
    "ticketRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ticket" }
    },
    "receiptRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/receiptRef" }
    },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "parentCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedBaseSha",
        "headSha",
        "checkpointSha",
        "checkpointReceiptRef",
        "snapshotReceiptRef",
        "secretScanReceiptRef"
      ],
      "properties": {
        "acceptedBaseSha": { "$ref": "#/$defs/sha" },
        "headSha": { "$ref": "#/$defs/sha" },
        "checkpointSha": { "$ref": "#/$defs/sha" },
        "checkpointReceiptRef": {
          "type": "string",
          "pattern": "^receipt:continuity[.][a-z0-9._:-]{1,148}$"
        },
        "snapshotReceiptRef": {
          "type": "string",
          "pattern": "^receipt:snapshot[.][a-z0-9._:-]{1,150}$"
        },
        "secretScanReceiptRef": {
          "type": "string",
          "pattern": "^receipt:secret-scan[.][a-z0-9._:-]{1,147}$"
        }
      }
    },
    "completedSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPaths",
        "materialPaths",
        "materialArtifactRefs",
        "validationReceiptRefs",
        "publicationState",
        "terminalReceiptRef"
      ],
      "properties": {
        "allowedPaths": { "$ref": "#/$defs/scope" },
        "materialPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/materialPath" }
        },
        "materialArtifactRefs": { "$ref": "#/$defs/artifactRefs" },
        "validationReceiptRefs": { "$ref": "#/$defs/receiptRefs" },
        "publicationState": { "enum": ["ready", "published"] },
        "terminalReceiptRef": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/receiptRef" }
          ]
        }
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "ticket",
        "intentRef",
        "allocationReceiptRef",
        "allowedPaths",
        "dependsOn",
        "conflictsWith",
        "integrationOwner",
        "state",
        "terminalReceiptRef"
      ],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "ticket": { "$ref": "#/$defs/ticket" },
        "intentRef": { "$ref": "#/$defs/artifactRef" },
        "allocationReceiptRef": {
          "type": "string",
          "pattern": "^receipt:allocation[.][a-z0-9._:-]{1,148}$"
        },
        "allowedPaths": { "$ref": "#/$defs/scope" },
        "dependsOn": { "$ref": "#/$defs/ticketRefs" },
        "conflictsWith": { "$ref": "#/$defs/ticketRefs" },
        "integrationOwner": { "type": "boolean" },
        "state": {
          "enum": [
            "allocated",
            "planned",
            "authorized",
            "editing",
            "validating",
            "publication",
            "blocked",
            "done"
          ]
        },
        "terminalReceiptRef": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/receiptRef" }
          ]
        }
      }
    }
  }
}
